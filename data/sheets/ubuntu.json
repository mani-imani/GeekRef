        }
      ]
    },
    {
      "id": "file",
      "title": "مدیریت فایل و دایرکتوری",
      "desc": "ایجاد، کپی، جابجایی، حذف فایل‌ها",
      "blocks": [
        {
          "type": "rows",
          "items": [
            {
              "cmd": "touch [file]",
