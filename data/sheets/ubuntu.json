    {
      "id": "cron",
      "title": "زمان‌بندی کارها (Cron)",
      "desc": "اجرای خودکار دستورات در زمان‌های مشخص",
      "blocks": [
        {
          "type": "rows",
          "items": [
            {
              "cmd": "crontab -e",
              "desc": "ویرایش crontab کاربر فعلی"
            },
            {
              "cmd": "crontab -l / -r",
