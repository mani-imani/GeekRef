    {
      "id": "shortcut",
      "title": "میانبرهای ترمینال و Redirect",
      "desc": "کلیدهای ضروری و عملگرهای bash",
      "blocks": [
        {
          "type": "rows",
          "items": [
            {
              "cmd": "cmd1 && cmd2",
              "desc": "اجرای cmd2 فقط اگر cmd1 موفق باشد"
            },
            {
              "cmd": "cmd1 || cmd2",
              "desc": "اجرای cmd2 فقط اگر cmd1 ناموفق باشد"
            },
            {
              "cmd": "cmd1 | cmd2",
              "desc": "انتقال خروجی cmd1 به ورودی cmd2"
            },
            {
              "cmd": "cmd > file",
              "desc": "redirect خروجی به فایل (بازنویسی)"
            },
            {
              "cmd": "cmd >> file",
              "desc": "redirect خروجی به فایل (الحاق)"
            },
            {
              "cmd": "cmd 2>&1",
              "desc": "ترکیب خروجی error با خروجی عادی"
            },
            {
              "cmd": "$(command)",
              "desc": "Command substitution: استفاده از خروجی دستور"
            },
            {
              "cmd": "cmd1; cmd2; cmd3",
              "desc": "اجرای دستورات پشت سر هم (بدون توجه به موفقیت)"
