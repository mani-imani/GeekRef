 "git.html"}, {"cmd": "git checkout -b <name>", "desc": "ساخت شاخه جدید و رفتن به آن", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git switch <branch>", "desc": "رفتن به شاخه دیگر (روش مدرن‌تر)", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git merge <branch>", "desc": "ادغام یک شاخه در شاخه فعلی", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git stash", "desc": "ذخیره موقت تغییرات ناتمام", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git branch -d <name>", "desc": "حذف شاخه پس از merge", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git clone <url>", "desc": "کپی مخزن از GitHub یا سرور ریموت", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git remote add origin <url>", "desc": "اتصال مخزن محلی به ریموت", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git push origin <branch>", "desc": "ارسال commit‌های محلی به ریموت", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git pull", "desc": "دریافت و ادغام تغییرات از ریموت", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git fetch", "desc": "دریافت تغییرات ریموت بدون ادغام", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git restore <file>", "desc": "بازگشت فایل به حالت آخرین commit", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git reset --soft HEAD~1", "desc": "برگشت از آخرین commit با حفظ تغییرات", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git reset --hard HEAD~1", "desc": "برگشت کامل — تغییرات حذف می‌شوند", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git revert <hash>", "desc": "ایجاد commit معکوس — ایمن‌ترین روش", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "git commit --amend", "desc": "ویرایش آخرین commit — پیام یا محتوا", "title": "Git", "icon": "🔀", "accent": "#f97316", "file": "git.html"}, {"cmd": "tree", "desc": "نمایش درختی همه فایل‌ها از دایرکتوری فعلی", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree /path/to/dir", "desc": "نمایش درختی یک مسیر مشخص", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -a", "desc": "نمایش فایل‌های مخفی (hidden) هم", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -d", "desc": "فقط دایرکتوری‌ها، بدون فایل", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -f", "desc": "نمایش مسیر کامل هر فایل", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -L 2", "desc": "محدود کردن عمق نمایش (اینجا ۲ سطح)", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -P \"*.py\"", "desc": "فقط فایل‌هایی که با پترن مطابقت دارند", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -I \"node_modules\"", "desc": "حذف فایل/فولدر مشخص از نمایش", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree --prune", "desc": "حذف دایرکتوری‌های خالی از خروجی", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -s", "desc": "نمایش سایز هر فایل (بایت)", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -h", "desc": "سایز به صورت خوانا (KB, MB, ...)", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -p", "desc": "نمایش permission هر فایل", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -u", "desc": "نمایش owner (مالک) فایل", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -D", "desc": "نمایش تاریخ آخرین تغییر", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree --du", "desc": "نمایش حجم کل هر دایرکتوری", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -C", "desc": "خروجی رنگی", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -o output.txt", "desc": "ذخیره خروجی در فایل", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree --noreport", "desc": "حذف خط آخر (تعداد فایل/فولدر)", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -J", "desc": "خروجی به فرمت JSON", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -X", "desc": "خروجی به فرمت XML", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -H . -o index.html", "desc": "خروجی HTML", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -L 2 -C -h", "desc": "فقط ۲ سطح، رنگی، با سایز", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -L 3 -P \"*.py\" --prune", "desc": "فقط فایل‌های پایتون تا ۳ سطح", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -I \"node_modules|.git\"", "desc": "همه چیز به جز node_modules و .git", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -d -p -u", "desc": "ساختار فولدرها با permission و مالک", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}, {"cmd": "tree -L 3 --noreport -o structure.txt", "desc": "ذخیره ساختار پروژه در فایل", "title": "tree", "icon": "🌳", "accent": "#a78bfa", "file": "tree.html"}]